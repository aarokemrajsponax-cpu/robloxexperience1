--!strict
-- Which build of the house this is. It's printed in Studio's Output when the game starts
-- ("[Maison] Build 33 ...") and shown small in the corner when playing in Studio, so it's easy to
-- see whether Studio has the latest code from GitHub.

return {
	number = 33,
	label = "Build 33 · 3 Oct · playable Foyer piano, clear doorways, no flicker, new signs",
}
